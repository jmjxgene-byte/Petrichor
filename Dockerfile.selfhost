# Self-hosted Bun production image. Build from the repository root.
# 固定为已在 Gene-OVH 核验过的生产工具链 digest。
FROM oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS dependencies
WORKDIR /app

COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/package.json
COPY patches patches
COPY scripts/prune-unused-framework-peers.ts scripts/prune-unused-framework-peers.ts
RUN bun install --frozen-lockfile

FROM dependencies AS builder
COPY . .
RUN bun run build

FROM oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=builder --chown=bun:bun /app/package.json /app/bun.lock ./
COPY --from=builder --chown=bun:bun /app/server.ts ./server.ts
COPY --from=builder --chown=bun:bun /app/deep-research-worker.ts ./deep-research-worker.ts
COPY --from=builder --chown=bun:bun /app/document-index-worker.ts ./document-index-worker.ts
COPY --from=builder --chown=bun:bun /app/node_modules ./node_modules
COPY --from=builder --chown=bun:bun /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder --chown=bun:bun /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder --chown=bun:bun /app/apps/web/tsconfig.json ./apps/web/tsconfig.json
COPY --from=builder --chown=bun:bun /app/apps/web/src ./apps/web/src
COPY --from=builder --chown=bun:bun /app/apps/web/dist ./apps/web/dist

USER bun
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["bun", "-e", "const response = await fetch('http://127.0.0.1:3000/healthz'); if (!response.ok) process.exit(1)"]
CMD ["bun", "server.ts"]
