{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "bun",
    "bunVersion": "1.x",
    "installCommand": "bun install --frozen-lockfile",
    "buildCommand": "bun run vercel-build",
    "functions": {
        "server.ts": {
            "includeFiles": "{apps/web/dist/**,apps/web/node_modules/drizzle-orm/**}",
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/external-source/cron-refresh",
            "schedule": "17 3 * * *"
        }
    ],
    "regions": ["sin1"]
}
