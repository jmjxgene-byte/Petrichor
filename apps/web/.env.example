# Supabase / PostgreSQL
DATABASE_URL="postgres://petrichor_runtime.[project-ref]:[password]@[pooler-host]:6543/postgres"
# 仅供本地受控迁移使用；不要配置到 Vercel
MIGRATION_DATABASE_URL="postgres://petrichor_migrator.[project-ref]:[password]@[pooler-host]:5432/postgres"
# 仅首次创建扩展与数据库角色时使用；完成后从本地环境移除
SUPABASE_ADMIN_DATABASE_URL=""
PETRICHOR_MIGRATOR_PASSWORD=""
PETRICHOR_RUNTIME_PASSWORD=""

# Better Auth session
SESSION_SECRET="replace-with-at-least-32-characters"
PETRICHOR_SESSION_EXPIRE_SECONDS="172800"

# API key encryption for AI model configs
PETRICHOR_ENCRYPT_KEY="replace-with-stable-random-secret"
PETRICHOR_ENCRYPT_SALT="replace-with-16-hex-chars"

# S3-compatible object storage
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="your-bucket"
S3_UPLOAD_EXPIRE_SECONDS="900"
S3_DOWNLOAD_EXPIRE_SECONDS="3600"
S3_USE_SSL="true"

# UI
PETRICHOR_PUBLIC_REGISTER_ENABLED="false"
# 服务端权威开关：disabled / open；生产保持 disabled
PETRICHOR_REGISTRATION_MODE="disabled"
APP_BASE_URL="http://localhost:3000"

# 仅执行 bun user:create-admin 时临时提供；不要配置到 Vercel
PETRICHOR_ADMIN_EMAIL=""
PETRICHOR_ADMIN_NAME=""
PETRICHOR_ADMIN_PASSWORD=""

# Optional LinuxDo OAuth
PETRICHOR_LINUXDO_CLIENT_ID=""
PETRICHOR_LINUXDO_CLIENT_SECRET=""
PETRICHOR_LINUXDO_REDIRECT_URI=""

# Optional Upstash Redis shared cache
# (public article list/detail, about, projects, site appearance, doc-library lists & document content)
# Leave empty to disable shared caching — the app falls back to the Bun process-local TTL cache.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
