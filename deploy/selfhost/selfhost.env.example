# Copy to .env.production on Gene-OVH and keep mode 0600. Never commit real values.
DATABASE_URL="postgres://petrichor_runtime.[project-ref]:[password]@[session-pooler-host]:5432/postgres"
PETRICHOR_DB_MAX_CONNECTIONS="5"

SESSION_SECRET="preserve-the-current-production-value"
PETRICHOR_SESSION_EXPIRE_SECONDS="172800"
PETRICHOR_ENCRYPT_KEY="preserve-the-current-production-value"
PETRICHOR_ENCRYPT_SALT="preserve-the-current-production-value"

APP_BASE_URL="https://petrichor-staging.genejm.one"
PETRICHOR_REGISTRATION_MODE="disabled"
PETRICHOR_GENEOPS_CONNECTOR_ENABLED="true"
CRON_SECRET="preserve-the-current-production-value"
PETRICHOR_DEEP_RESEARCH_ENABLED="false"
PETRICHOR_DEEP_RESEARCH_AUTO_START="false"
PETRICHOR_DEEP_RESEARCH_WORKER_ENABLED="false"
PETRICHOR_GENEOPS_HYBRID_ENABLED="false"
PETRICHOR_GENEOPS_WIKI_ENABLED="false"
PETRICHOR_GENEOPS_GRAPH_V2_ENABLED="false"

S3_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID="preserve-the-current-production-value"
S3_SECRET_ACCESS_KEY="preserve-the-current-production-value"
S3_BUCKET="preserve-the-current-production-value"
S3_UPLOAD_EXPIRE_SECONDS="900"
S3_DOWNLOAD_EXPIRE_SECONDS="3600"
S3_USE_SSL="true"

PETRICHOR_LINUXDO_CLIENT_ID=""
PETRICHOR_LINUXDO_CLIENT_SECRET=""
PETRICHOR_LINUXDO_REDIRECT_URI="https://petrichor-staging.genejm.one/api/auth/callback/linuxdo"
